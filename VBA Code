'________________
'1st code for opening the module
Sub ShowUserForm()
    UserFormYear.Show
End Sub

'________________________________
' 2nd Code for UserForm
Private Sub UserForm_Initialize()
    Dim i As Integer
    
    'Isi ComboBox Tahun (2000 hingga 2023)

    With Me.ComboBoxYear
        For i = 2000 To 2023
            .AddItem i
        Next i
    End With
    
    ' Set nilai default
    Me.OptionButtonMale.Value = True
    Me.OptionButtonAll.Value = True
End Sub

Private Sub ToggleButtonCANCEL_Click()
'close the userform
Unload UserFormYear
End Sub

Private Sub ToggleButtonRESET_Click()
    'Set "Gender" ke pilihan default
    Me.OptionButtonMale.Value = True
    
    'Set "Ethnic" ke pilihan default
    Me.OptionButtonAll.Value = True
    
    'Kosongkan pilihan "Year"
    Me.ComboBoxYear.Value = ""
    
    'Letak kursor kembali pada ComboBoxYear
    Me.ComboBoxYear.SetFocus
End Sub

Private Sub ToggleButtonOK_Click()

    Sheet2.Range("E2").Value = Now()
    
    'define
    Dim dataSheet As Worksheet
    Dim programSheet As Worksheet
    
    On Error GoTo ErrorHandlerSheet
    Set dataSheet = ThisWorkbook.Sheets("birth_sex_ethnic")
    Set programSheet = ThisWorkbook.Sheets("Program")
    On Error GoTo 0

    'DAPATKAN INPUT & BUAT TERJEMAHAN
    Dim selectedYear As String
    Dim selectedSex As String
    Dim selectedEthnic As String
    
    ' Input TAHUN
    If Trim(Me.ComboBoxYear.Value) = "" Then
        MsgBox "Sila pilih 'Year'.", vbExclamation, "Input Tidak Lengkap"
        Me.ComboBoxYear.SetFocus
        Exit Sub
    End If
    selectedYear = Trim(Me.ComboBoxYear.Value)
    
    ' Input GENDER
    If Me.OptionButtonBoth.Value = True Then
        selectedSex = "both"
    ElseIf Me.OptionButtonMale.Value = True Then
        selectedSex = "male"
    ElseIf Me.OptionButtonFemale.Value = True Then
        selectedSex = "female"
    Else
        MsgBox "Sila pilih 'Gender'.", vbExclamation, "Input Tidak Lengkap"
        Exit Sub
    End If
    
    'Input ETHNIC
    If Me.OptionButtonAll.Value = True Then
        selectedEthnic = "overall"
    ElseIf Me.OptionButtonMalay.Value = True Then
        selectedEthnic = "bumi_malay"
    ElseIf Me.OptionButtonChinese.Value = True Then
        selectedEthnic = "chinese"
    ElseIf Me.OptionButtonIndian.Value = True Then
        selectedEthnic = "indian"
    ElseIf Me.OptionButtonOB.Value = True Then
        selectedEthnic = "bumi_other"
    ElseIf Me.OptionButtonOC.Value = True Then
        selectedEthnic = "other_citizen"
    ElseIf Me.OptionButtonNO.Value = True Then
        selectedEthnic = "other_noncitizen"
    Else
        MsgBox "Sila pilih 'Ethnic'.", vbExclamation, "Input Tidak Lengkap"
        Exit Sub
    End If
    
    'padam output lama
    programSheet.Range("E4:E8").ClearContents

    'Bina LookupKey
    Dim lookupKey As String
    lookupKey = selectedYear & "-" & selectedSex & "-" & selectedEthnic
    
    'Set Range
    Dim lookupRange As Range
    Set lookupRange = dataSheet.Range("A:F")
    
    Dim liveBirth As Variant
    Dim cbr As Variant 'Crude Birth Rate
    
    'Guna VLOOKUP
    On Error Resume Next
    liveBirth = Application.WorksheetFunction.VLookup(lookupKey, lookupRange, 5, False)
    cbr = Application.WorksheetFunction.VLookup(lookupKey, lookupRange, 6, False)
    
    If Err.Number <> 0 Then
        On Error GoTo 0
        programSheet.Range("E4").Value = selectedYear
        programSheet.Range("E5").Value = selectedSex
        programSheet.Range("E6").Value = selectedEthnic
        programSheet.Range("E7").Value = "N/A"
        programSheet.Range("E8").Value = "N/A"
    Else
        On Error GoTo 0
        programSheet.Range("E4").Value = selectedYear
        programSheet.Range("E5").Value = selectedSex
        programSheet.Range("E6").Value = selectedEthnic
        
    'ada data kosong, gantikan dengan N/A
        If IsEmpty(liveBirth) Or liveBirth = 0 Then
            programSheet.Range("E7").Value = "N/A"
        Else
            programSheet.Range("E7").Value = liveBirth
        End If
        If IsEmpty(cbr) Or cbr = 0 Then
            programSheet.Range("E8").Value = "N/A"
        Else
            programSheet.Range("E8").Value = cbr
        End If
    End If

    Exit Sub

ErrorHandlerSheet:
    MsgBox "ERROR: Sheet tidak dijumpai!" & vbCrLf & _
           "Pastikan awak ada sheet 'birth_sex_ethnic' dan 'Program'.", vbCritical
End Sub
